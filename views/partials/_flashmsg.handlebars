{{#if flashMessenger }}
{{#each flashMessenger.alertsBeforeFlush}}
<div class="alert alert-{{this.type}} role="alert" {{#if this.canBeDismissed}}alertdismissible{{/if}} z-index:9999">
    {{#if this.canBeDismissed}}
    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
        <span class="lnr lnr-cross" aria-hidden="true"></span>
    </button>
    {{/if}}
    <h6>
        {{#if this.titleIcon}}
        <span class="{{this.titleIcon}}"></span>
        {{/if}}
        {{this.title}}
    </h6>
    {{#if this.messages}}
    <ol>
        {{#each this.messages}}
        <li>{{this}}</li>
        {{/each}}
    </ol>
    {{/if}}
</div>
{{/each}}
{{/if}}