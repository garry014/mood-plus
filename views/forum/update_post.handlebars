<!--================================
        START DASHBOARD AREA
=================================-->
<section class="support_threads_area section--padding2">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="question-form cardify p-4">
                    <form id="postform" method="POST"> <!-- action="/forum/create_thread" -->
                        <div class="form-group">
                            <input type="hidden" name="threadId" value="{{postDetails.threadId}}">
                            <label>Post Description:</label>
                            <textarea id="post" name="post" style="display:none;">{{postDetails.post}}</textarea>
                            <div id="trumbowyg-demo"></div>
                        </div>
                        
                        <div class="form-group">
                            <span class="lnr lnr-menu-circle"></span> To ensure Mood+ remains a safe space for all, your post will be vetted by our Artifical Intelligence.<br>
                            <button type="button" onclick="submitForm()" style="float: right;" class="btn btn--md btn-primary">Update Post</button>
                            <br><br>
                        </div>
                    </form>
                </div><!-- ends: .question-form -->
            </div>
            <!-- end .col-md-8 -->

            <div class="col-lg-4">
                <aside class="sidebar support--sidebar">
                    <div class="sidebar-card card--forum_categories">
                        <div class="card-title">
                            <h4>Forum Categories</h4>
                        </div>
                        <div class="collapsible-content">
                            <ul class="card-content">
                                <li>
                                    <a href="/forum">
                                        <span class="lnr lnr-chevron-right"></span>All Categories
                                        <!--<span class="item-count">35</span>-->
                                    </a>
                                </li>
                                <li>
                                    <a href="/forum?category=Experiences">
                                        <span class="lnr lnr-chevron-right"></span>Experiences
                                        <!--<span class="item-count">35</span>-->
                                    </a>
                                </li>
                                <li>
                                    <a href="/forum?category=Grief">
                                        <span class="lnr lnr-chevron-right"></span>Grief
                                        <!--<span class="item-count">35</span>-->
                                    </a>
                                </li>
                                <li>
                                    <a href="/forum?category=Abuse">
                                        <span class="lnr lnr-chevron-right"></span>Abuse
                                        <!--<span class="item-count">35</span>-->
                                    </a>
                                </li>
                                <li>
                                    <a href="/forum?category=Relationships">
                                        <span class="lnr lnr-chevron-right"></span>Relationships
                                        <!--<span class="item-count">35</span>-->
                                    </a>
                                </li>
                                <li>
                                    <a href="/forum?category=Others">
                                        <span class="lnr lnr-chevron-right"></span>Others
                                        <!--<span class="item-count">35</span>-->
                                    </a>
                                </li>
                            </ul>
                        </div>
                    <!-- end .card--forum_categories -->
                </aside>
                <!-- end .sidebar -->
            </div>
            <!-- end .col-md-4 -->
        </div>
        <!-- end .row -->
    </div>
    <!-- end .container -->
</section>
<!--================================
        END DASHBOARD AREA
=================================-->

<script>
    var trumbowygPost;
    window.addEventListener("load", (event) => {
        trumbowygPost = document.querySelector('textarea[name="trumbowyg-demo"]');
        document.getElementById('trumbowyg-demo').innerHTML = (decodeHtml(`{{postDetails.post}}`));
    });
    
    function submitForm(){
        var post = document.getElementById('post');
        post.value = trumbowygPost.value;
        document.getElementById('postform').submit();
    }

    function decodeHtml(html) {
        var txt = document.createElement("textarea");
        txt.innerHTML = html;
        return txt.value;
    }
</script>