    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="breadcrumb">
                    <ul>
                        <li>
                            <a href="index.html">Home</a>
                        </li>
                        <li>
                            <a href="/forum">Forum</a>
                        </li>
                        <li class="active">
                            <a href="#">Report</a>
                        </li>
                    </ul>
                </div>
                <h1 class="page-title">Report Thread/Post</h1>
            </div>
            <!-- end /.col-md-12 -->
        </div>
        <!-- end /.row -->
    </div>
    <!-- end /.container -->
