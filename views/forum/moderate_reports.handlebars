<!--================================
    START BREADCRUMB AREA
=================================-->
<section class="breadcrumb-area">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="breadcrumb">
                    <ul>
                        <li>
                            <a href="index.html">Home</a>
                        </li>
                        <li>
                            <a href="/forum">Forum</a>
                        </li>
                        <li class="active">
                            <a href="#">Moderator Panel</a>
                        </li>
                    </ul>
                </div>
                <h1 class="page-title">Manage Reports</h1>
            </div>
            <!-- end /.col-md-12 -->
        </div>
        <!-- end /.row -->
    </div>
    <!-- end /.container -->
</section>
<!--================================
    END BREADCRUMB AREA
=================================-->

<!--================================
        START DASHBOARD AREA
=================================-->
<section class="section--padding2 bgcolor">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="">
                    <div class="modules__content">
                        <div class="withdraw_module withdraw_history">
                            <div class="withdraw_table_header">
                                <h3>Reports</h3>
                            </div>
                            <div class="table-responsive">
                                <table class="table withdraw__table">
                                    <thead>
                                        <tr>
                                            <th>Timestamp</th>
                                            <th>Thread/Post</th>
                                            <th>Reasons</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        {{#each reports}}
                                        <tr>
                                            <td>{{timestamp}}</td>
                                            <td id="post-{{id}}">{{post}}</td>
                                            <td>{{classification}}</td>
                                            <td>
                                                <a href="/forum/set_report/accepted/{{type}}/{{id}}" title="Accept Report"><i class="fa fa-check-circle" aria-hidden="true" style="font-size: 28px;"></i></a> &nbsp;&nbsp;
                                                {{!-- <a href="/forum/set_report/edit/{{type}}/{{id}}"><span class="lnr lnr-pencil"></span></a> &nbsp;&nbsp; --}}
                                                <a href="/forum/set_report/rejected/{{type}}/{{id}}" title="Decline Report"><i class="fa fa-times" aria-hidden="true" style="color: red; font-size: 28px;"></i></span></a>
                                            </td>
                                        </tr>
                                        {{/each}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- end .col-md-6 -->
        </div>
        <!-- end .row -->
    </div>
    <!-- end .container -->
</section>
<!--================================
        END DASHBOARD AREA
=================================-->

<script>
    {{#each reports}}
    document.getElementById('post-{{id}}').innerHTML = decodeHtml("{{post}}");
    {{/each}}

    function decodeHtml(html) {
        var txt = document.createElement("textarea");
        txt.innerHTML = html;
        return txt.value;
    }
</script>