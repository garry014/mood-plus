<!--================================ START BREADCRUMB AREA =================================-->
<section class="breadcrumb-area">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="breadcrumb">
                    <ul>
                        <li>
                            <a href="/">Home</a>
                        </li>
                        <li>
                            <a href="/forum">Forum</a>
                        </li>
                        <li class="active">
                            <a href="#">{{threadDetails.title}}</a>
                        </li>
                    </ul>
                </div>
                <h1 class="page-title">View Thread</h1>
            </div>
            <!-- end /.col-md-12 -->
        </div>
        <!-- end /.row -->
    </div>
    <!-- end /.container -->
</section>
<!--================================
    END BREADCRUMB AREA
=================================-->

<!--================================
        START DASHBOARD AREA
=================================-->
<section class="support_threads_area section--padding2">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="forum_detail_area ">
                    <div class="cardify forum--issue">
                        <div class="title_vote clearfix">
                            <h3><button onclick="listen('currentThreadPost')" title="Listen to text"><span class="lnr lnr-volume-medium"></span></button> {{threadDetails.title}}</h3>
                            <div class="filter__menu">
                                {{#if user}}
                                <div class="filter__menu_icon">
                                    <a id="drop1" class="dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <img class="svg" src="/images/svg/menu.svg" alt="menu icon">
                                    </a>

                                    <ul class="filter_dropdown dropdown-menu" aria-labelledby="drop1">
                                        <li>
                                            {{#ifCond threadDetails.username '==' user.username}}
                                            <a href="/forum/update_thread/{{threadDetails.id}}"><span class="lnr lnr-pencil"></span> Edit</a>
                                            {{/ifCond}}
                                            {{#ifCond user.usertype '==' "admin"}}
                                            <a href="/forum/update_thread/{{threadDetails.id}}"><span class="lnr lnr-pencil"></span> Edit</a>
                                            {{/ifCond}}
                                        </li>
                                        {{#ifCond user.usertype '==' "admin"}}
                                        <li>
                                            <a href="/forum/pin_thread/{{threadDetails.id}}"><span class="lnr lnr-pushpin"></span> {{#if threadDetails.isPinned}}Unpin{{else}}Pin{{/if}}</a>
                                        </li>
                                        {{/ifCond}}
                                        <li>
                                            {{#ifCond threadDetails.username '==' user.username}}
                                            <a href="/forum/delete_thread/{{threadDetails.id}}"><span class="lnr lnr-trash"></span> Delete</a>
                                            {{/ifCond}}
                                            {{#ifCond user.usertype '==' "admin"}}
                                            <a href="/forum/delete_thread/{{threadDetails.id}}"><span class="lnr lnr-trash"></span> Delete</a>
                                            {{/ifCond}}
                                        </li>
                                        <li>
                                            {{#ifCond threadDetails.username '!=' user.username}}
                                            <a href="/forum/report/thread/{{threadDetails.id}}"><span class="lnr lnr-flag"></span> Report</a>
                                            {{/ifCond}}
                                        </li>
                                    </ul>
                                </div>
                                {{/if}}
                            </div>
                            <!-- end .vote -->
                        </div>
                        <!-- end .title_vote -->
                        <div class="suppot_query_tag">
                            <a href="#" class="user">
                                <img class="poster_avatar" src="/images/usr_avatar.png" alt="Support Avatar"> 
                                {{#if threadDetails.name}}
                                {{threadDetails.name}}
                                {{else}}
                                {{threadDetails.username}}
                                {{/if}} 
                                </a>
                            <span>posted on {{threadDetails.timestamp}}</span>
                            {{#if threadDetails.hiddenReason}}
                                {{#ifCond threadDetails.vettingRequest '==' null}}
                                <a href="/forum/appeal/thread/{{threadDetails.id}}"><span class="support_tag" style="background-color:red;">marked as inappropriate | appeal?</span></a>
                                {{/ifCond}}
                                {{#ifCond threadDetails.vettingRequest '==' "pending"}}
                                <span class="support_tag" style="background-color:#FFA500;">marked as inappropriate | appeal pending</span>
                                {{/ifCond}}
                                {{#ifCond threadDetails.vettingRequest '==' "rejected"}}
                                <span class="support_tag" style="background-color:red;">marked as inappropriate | appeal rejected</span>
                                {{/ifCond}}
                            {{else}}
                            <span class="support_tag">{{threadDetails.category}}</span>
                            {{#ifCond threadDetails.usertype '!=' 'customer'}}
                                <span class="support_tag" style="background-color:#0674ec">{{threadDetails.usertype}}</span>
                            {{/ifCond}}
                            {{/if}}
                        </div>
                        <div id="currentThreadPost"></div>
                        {{#if threadDetails.editedBy}}
                            <span style="float:right"><i>Last edited by <a href="#" class="user">{{threadDetails.editedBy}}</a> on {{threadDetails.editTime}}</i></span>
                        {{/if}}
                    </div>
                    <!-- end .forum_issue -->


                    <div class="forum--replays cardify">
                        <div class="area_title">
                            <h4>Posts</h4>
                        </div>
                        <!-- end .area_title -->
                        {{#each posts}}
                        <div class="forum_single_reply">
                            <div class="reply_avatar">
                                <img src="/images/usr_avatar.png" alt="reply avatar">
                            </div>

                            <div class="reply_content">
                                <div class="name_vote">
                                    <div class="pull-left">
                                        <h4>
                                            {{#if name}}
                                            {{name}}
                                            {{else}}
                                            {{username}}
                                            {{/if}} 
                                            {{#ifCond usertype '!=' 'customer'}}
                                            <span>{{usertype}}</span>
                                            {{/ifCond}}
                                            {{#if hiddenReason}}
                                                {{#ifCond vettingRequest '==' null}}
                                                <a href="/forum/appeal/post/{{id}}"><span class="support_tag" style="background-color:red;">marked as inappropriate | appeal?</span></a>
                                                {{/ifCond}}
                                                {{#ifCond vettingRequest '==' "pending"}}
                                                <span class="support_tag" style="background-color:#FFA500;">marked as inappropriate | appeal pending</span>
                                                {{/ifCond}}
                                                {{#ifCond vettingRequest '==' "rejected"}}
                                                <span class="support_tag" style="background-color:red;">marked as inappropriate | appeal rejected</span>
                                                {{/ifCond}}
                                            {{/if}}
                                        </h4>
                                        <p>{{timestamp}}</p>
                                    </div>
                                    <!-- end .pull-left -->
                                    
                                    <div class="filter__menu">
                                        <div class="filter__menu_icon">
                                            <a id="drop1" class="dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                <img class="svg" src="/images/svg/menu.svg" alt="menu icon">
                                            </a>

                                            <ul class="filter_dropdown dropdown-menu" aria-labelledby="drop1">
                                                {{#ifCond username '==' ../user.username}}
                                                <li>
                                                    <a href="/forum/update_post/{{id}}"><span class="lnr lnr-pencil"></span> Edit</a>
                                                </li>
                                                <li>
                                                    <a href="/forum/delete_post/{{id}}"><span class="lnr lnr-trash"></span> Delete</a>
                                                </li>
                                                {{/ifCond}}
                                                {{#ifCond username '!=' ../user.username}}
                                                <li>
                                                    <a href="/forum/report/post/{{id}}"><span class="lnr lnr-flag"></span> Report</a>
                                                </li>
                                                {{/ifCond}}
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <!-- end .vote -->
                                <br>
                                <div id="post-{{id}}"></div>
                            </div>
                            <!-- end .reply_content -->
                        </div>
                        {{else}}
                        <div class="area_title">
                            <h6>Currently empty, be the first one to reply!</h6>
                        </div>
                        {{/each}}
                        <!-- end .forum_single_reply -->

                        {{#if posts}}
                        <div class="pagination-area pagination-area2">
                            <nav class="navigation pagination " role="navigation">
                                <div class="pagination-area">
                                    {{#paginate pagination type="previous"}}
                                    {{#unless disabled}}<a class="prev page-numbers" href="/forum/view_thread/{{../threadDetails.id}}?page={{n}}"><span class="lnr lnr-arrow-left"></span></a>{{/unless}}
                                    {{/paginate}}
                                    {{#paginate pagination type="middle" limit=totalpage}}
                                    <a class="page-numbers {{#if active}}current{{/if}}" href="/forum/view_thread/{{../threadDetails.id}}?page={{n}}">{{n}}</a>
                                    {{/paginate}}
                                    {{#paginate pagination type="next"}}
                                    {{#unless disabled}}<a class="next page-numbers" href="/forum/view_thread/{{../threadDetails.id}}?page={{n}}"><span class="lnr lnr-arrow-right"></span></a>{{/unless}}
                                    {{/paginate}}
                                </div>
                            </nav>
                        </div>
                        {{/if}}
                        <!-- end /.pagination-area -->

                        <div class="comment-form-area">
                            {{#if user}}
                            <h4>Post</h4>
                            <!-- comment reply -->
                            <div class="media comment-form support__comment">
                                <div class="media-body">
                                    <form class="comment-reply-form" method="POST">
                                        <div id="trumbowyg-demo"></div>
                                        <textarea id="post" name="post" style="display:none;"></textarea>
                                        <input type="hidden" id="custId" name="postCount" value="{{postCount}}">
                                        <!-- Voice to Text -->
                                        <script src="https://www.WebRTC-Experiment.com/RecordRTC.js"></script>
                                        <div class="real-time-interface">
                                            <button id="voiceTranscriptButton" type="button" class="btn btn--icon btn-sm btn--round btn-secondary">
                                                <span class="lnr lnr-mic"></span> Start Voice Transcript
                                            </button>
                                            <p id="message" class="real-time-interface__message"></p>
                                        </div>
                                        <!-- voice to text -->
                                        <span class="lnr lnr-menu-circle"></span> To ensure Mood+ remains a safe space for all, your post will be vetted by our Artifical Intelligence.<br>
                                        <button onclick="submitForm()" style="float: right;" class="btn btn--md btn-primary">Post Comment</button>
                                        <br><br>
                                    </form>
                                </div>
                            </div>
                            {{else}}
                            <button class="btn btn-lg" onclick="location.href='/user/login';"><span class="lnr lnr-lock"></span> Login to Post</button>
                            {{/if}}
                            <!-- comment reply -->
                        </div>
                    </div>
                    <!-- end .forum_replays -->
                </div>
                <!-- end .forum_detail_area -->
            </div>
            <!-- end .col-md-8 -->

            <div class="col-lg-4">
                <aside class="sidebar support--sidebar">
                    <div class="sidebar-card card--forum_categories">
                        <div class="card-title">
                            <h4>Forum Categories</h4>
                        </div>
                        <div class="collapsible-content">
                            <ul class="card-content">
                                <li>
                                    <a href="/forum">
                                        <span class="lnr lnr-chevron-right"></span>All Categories
                                        <!--<span class="item-count">35</span>-->
                                    </a>
                                </li>
                                <li>
                                    <a href="/forum?category=Experiences">
                                        <span class="lnr lnr-chevron-right"></span>Experiences
                                        <!--<span class="item-count">35</span>-->
                                    </a>
                                </li>
                                <li>
                                    <a href="/forum?category=Grief">
                                        <span class="lnr lnr-chevron-right"></span>Grief
                                        <!--<span class="item-count">35</span>-->
                                    </a>
                                </li>
                                <li>
                                    <a href="/forum?category=Abuse">
                                        <span class="lnr lnr-chevron-right"></span>Abuse
                                        <!--<span class="item-count">35</span>-->
                                    </a>
                                </li>
                                <li>
                                    <a href="/forum?category=Relationships">
                                        <span class="lnr lnr-chevron-right"></span>Relationships
                                        <!--<span class="item-count">35</span>-->
                                    </a>
                                </li>
                                <li>
                                    <a href="/forum?category=Others">
                                        <span class="lnr lnr-chevron-right"></span>Others
                                        <!--<span class="item-count">35</span>-->
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <!-- end /.collapsible_content -->
                    </div>
                        <!-- end /.collapsible_content -->
                    </div>
                    <!-- end .card--forum_categories -->
                </aside>
                <!-- end .sidebar -->
            </div>
            <!-- end .col-md-4 -->
        </div>
        <!-- end .row -->
    </div>
    <!-- end .container -->
</section>
<!--================================
        END DASHBOARD AREA
=================================-->

<!-- Delete Modal -->
<form action="/tailor/deleteProduct/{{id}}" style="display: inline-block;">
    <!-- The Modal -->
    <div class="modal" id="myModal_{{id}}">
      <div class="modal-dialog">
        <div class="modal-content">

          <!-- Modal Header -->
          <div class="modal-header">
                <h4 class="modal-title">Delete Confirmation</h4>
            <button type="button" class="close" data-dismiss="modal">&times;</button>
          </div>

          <!-- Modal body -->
          <div class="modal-body">
            Are you sure you want to delete {{name}}
          </div>

          <!-- Modal footer -->
          <div class="modal-footer">
           <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
              <button type="submit" value="Delete" class="btn btn-danger">Delete</button>
          </div>

        </div>
      </div>
    </div>
</form>

<script src="/js/speechToText.js"></script>
<script src="/js/readAloud.js"></script>
<script>
    document.getElementById('currentThreadPost').innerHTML += decodeHtml("{{threadDetails.post}}")

    function decodeHtml(html) {
        var txt = document.createElement("textarea");
        txt.innerHTML = html;
        return txt.value;
    }

    window.addEventListener("load", (event) => {
        {{#each posts}}
        document.getElementById('post-{{id}}').innerHTML = decodeHtml("{{post}}");
        {{/each}}
    });

    function decodeHtml(html) {
        var txt = document.createElement("textarea");
        txt.innerHTML = html;
        return txt.value;
    }
</script>