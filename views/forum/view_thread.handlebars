        <div class="row">
            <div class="col-md-12">
                <div class="breadcrumb">
                    <ul>
                        <li>
                            <a href="/">Home</a>
                        </li>
                        <li>
                            <a href="/forum">Forum</a>
                        </li>
                        <li class="active">
                            <a href="#">{{threadDetails.title}}</a>
                        </li>
                    </ul>
                </div>
                <h1 class="page-title">View Thread</h1>
