<!--================================
    START BREADCRUMB AREA
=================================-->
<section class="breadcrumb-area">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="breadcrumb">
                    <ul>
                        <li>
                            <a href="/">Home</a>
                        </li>
                        <li {{#ifCond searchText '==' null}}class="active"{{/ifCond}}>
                            <a href="/forum">Forum</a>
                        </li>
                        {{#ifCond searchText '!=' null}}
                        <li class="active">
                            <a href="#">Search Threads</a>
                        </li>
                        {{/ifCond}}
                    </ul>
                </div>
                <h1 class="page-title">A safe space for mental health dicussions</h1>
            </div>
            <!-- end /.col-md-12 -->
        </div>
        <!-- end /.row -->
    </div>
    <!-- end /.container -->
</section>
<!--================================
    END BREADCRUMB AREA
=================================-->

<!--================================
        START DASHBOARD AREA
=================================-->
<section class="support_threads_area section--padding2">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="support_threads">
                    <div class="thread_sort_area clearfix">
                        <div class="sort_options">
                            <ul>
                                <li {{#ifCond filter '==' null}}class="active"{{/ifCond}}>
                                    <a href="/forum">All</a>
                                </li>
                                <li {{#ifCond filter '==' 'open'}}class="active"{{/ifCond}}>
                                    <a href="/forum?filter=open">Open</a>
                                </li>
                                <li {{#ifCond filter '==' 'closed'}}class="active"{{/ifCond}}>
                                    <a href="/forum?filter=closed">Closed</a>
                                </li>
                            </ul>
                        </div>
                        <!-- end .sort_options -->

                        <div class="thread_search_area">
                            <form method="POST">
                                <div class="searc-wrap">
                                    <input type="text" name="searchText" placeholder="Search forum" value="{{searchText}}">
                                    <button type="submit" class="search-wrap__btn">
                                        <span class="lnr lnr-magnifier"></span>
                                    </button>
                                </div>
                            </form>
                        </div>
                        <!-- end .thread_search_area -->
                    </div>
                    <!-- end .thread_sort_area -->

                    {{#each threads}}
                        {{#if hiddenReason}}
                            <div class="support_thread_list cardify">
                                <div class="support_thread--single">
                                    <div class="support_thread_info">
                                        {{#ifCond username '==' ../user.username}}
                                        <a href="/forum/view_thread/{{id}}" class="support_title">{{#if isClosed}}<i class="fa fa-lock" aria-hidden="true"></i> {{/if}}{{title}}
                                            {{#if isPinned}}<span class="pinned">Pinned</span>{{/if}}
                                        </a>
                                        {{else}}
                                        <a href="#" class="support_title"><i>This thread is marked as inappropriate.</i>
                                            {{#if isPinned}}<span class="pinned">Pinned</span>{{/if}}
                                        </a>
                                        {{/ifCond}}
                                        <div class="suppot_query_tag">
                                            <a href="#" class="user">
                                                <img class="poster_avatar" src="/images/usr_avatar.png" alt="Support Avatar"> {{username}} </a>
                                            <span>{{timestamp}}</span>
                                            <span class="support_tag">{{category}}</span> <!--color code tags-->
                                        </div>
                                    </div>
                                    <!-- end .support_thread_info -->
                                </div>
                            </div>
                        {{else}}
                        <div class="support_thread_list cardify">
                            <div class="support_thread--single">
                                <div class="support_thread_info">
                                    <div class="summarytooltip">
                                        <a href="/forum/view_thread/{{id}}" class="support_title">{{#if isClosed}}<i class="fa fa-lock" aria-hidden="true"></i> {{/if}}{{title}}
                                            {{#if isPinned}}<span class="pinned">Pinned</span>{{/if}}
                                        </a>
                                        <span class="tooltiptext"><b>Summary:</b> {{summary}}...</span>
                                    </div>
                                    <div class="suppot_query_tag">
                                        <a href="#" class="user">
                                            <img class="poster_avatar" src="/images/usr_avatar.png" alt="Support Avatar"> 
                                                {{#if name}}
                                                {{name}}
                                                {{else}}
                                                {{username}}
                                                {{/if}}
                                            </a>
                                        <span>{{timestamp}}</span>
                                        <span class="support_tag">{{category}}</span> <!--color code tags-->
                                    </div>
                                </div>
                                <!-- end .support_thread_info -->

                                {{!-- <div class="support_thread_meta">
                                    <ul>
                                        <li class="answer_time">
                                            <img src="/images/support_avat4.png" alt="Support images">  
                                        </li>
                                        <li>
                                            <p class="number">2</p>
                                            <span>votes</span>
                                        </li>
                                        <li>
                                            <p class="number">6</p>
                                            <span>replies</span>
                                        </li>
                                    </ul>
                                </div> --}}
                                <!-- end .support_thread_meta -->
                            </div>
                            <!-- end .support_thread--single -->
                        </div>
                        {{/if}}
                    {{else}}
                    The forum is looking empty, be the first one to post!
                    {{/each}}
                    
                    <!-- end .support_thread_list -->
                    
                    {{#if threads}}
                    <div class="pagination-area pagination" style="justify-content: center;">
                        <nav class="navigation pagination " role="navigation">
                            <div class="pagination-area">
                                {{#paginate pagination type="previous"}}
                                {{#unless disabled}}<a class="prev page-numbers" href="/forum?page={{n}}"><span class="lnr lnr-arrow-left"></span></a>{{/unless}}
                                {{/paginate}}
                                {{#paginate pagination type="middle" limit=totalpage}}
                                <a class="page-numbers {{#if active}}current{{/if}}" href="/forum?page={{n}}">{{n}}</a>
                                {{/paginate}}
                                {{#paginate pagination type="next"}}
                                {{#unless disabled}}<a class="next page-numbers" href="/forum?page={{n}}"><span class="lnr lnr-arrow-right"></span></a>{{/unless}}
                                {{/paginate}}
                            </div>
                        </nav>
                    </div>
                    {{/if}}
                </div>
                <!-- end .support_threads -->
            </div>
            <!-- end .col-md-8 -->

            <div class="col-lg-4">
                <aside class="sidebar support--sidebar">
                    {{#if user.firstname}}
                    <a href="/forum/create_thread" class="login_promot">
                        <span class="lnr lnr-pencil"></span>Create New Thread
                    </a>
                    {{else}}
                    <a href="/user/login" class="login_promot">
                        <span class="lnr lnr-lock"></span>Login to Create Thread
                    </a>
                    {{/if}}

                    <!--<span class="lnr lnr-lock"></span>Login to Ask a Question-->

                    <div class="sidebar-card card--forum_categories">
                        <div class="card-title">
                            <h4>Forum Categories</h4>
                        </div>
                        <div class="collapsible-content">
                            <ul class="card-content">
                                <li>
                                    <a href="/forum">
                                        <span class="lnr lnr-chevron-right"></span>All Categories
                                        <!--<span class="item-count">35</span>-->
                                    </a>
                                </li>
                                {{#each categories}}
                                <li>
                                    <a href="/forum?category={{this}}">
                                        <span class="lnr lnr-chevron-right"></span>{{this}}
                                        <!--<span class="item-count">35</span>-->
                                    </a>
                                </li>
                                {{/each}}
                            </ul>
                        </div>
                        <!-- end /.collapsible_content -->
                    </div>
                    <div class="sidebar-card card--top_discussion">
                            <div class="card-title">
                                <h4>Translate Text</h4>
                            </div>
                            <br>
                            <div class="collapsible-content">
                                <div id="google_translate_element" style="font-family: 'Quicksand', sans-serif;"></div>
                                <script type="text/javascript" src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
                                <script>
                                    function googleTranslateElementInit() {
                                        new google.translate.TranslateElement({ pageLanguage: 'en', layout: google.translate.TranslateElement.InlineLayout.SIMPLE }, 'google_translate_element');
                                    }
                                </script>
                            </div>
                            <br>
                            <!-- end /.collapsible_content -->
                        </div>
                        <!-- end /.collapsible_content -->
                    </div>
                    <!-- end .card--forum_categories -->
                </aside>
                <!-- end .sidebar -->
            </div>
            <!-- end .col-md-4 -->
        </div>
        <!-- end .row -->
    </div>
    <!-- end .container -->
</section>
<!--================================
        END DASHBOARD AREA
=================================-->
