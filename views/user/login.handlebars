<br><br>
<div class="row">
	<div class="col-md-6 mx-auto">
		<a href="/user/loginadmin" style="float:right; font-weight: bold;">Login as Admin here</a> <br>
		<a href="/user/logincounsellor" style="float:right; font-weight: bold;">Login as Counsellor here</a> 
		<br>
		<div class="card card-body">
			<h3 class="text-center">Account Login</h3>
			<div>
				<br>
				<h6> <a href="/user/register" style=";">Don't have an account yet? Register here now!</a>  </h6>
				<br>
			</div>
			
			<form method="post" action="/user/login"> 
				<div class="form-group">
					<label for="text">Username</label>
					<input type="text" name="username" class="form-control" required>
				</div>
				<div class="form-group">
					<label for="password">Password</label>
					<input type="password" name="password" class="form-control" required>
				</div>
				<input type="hidden" name="usertype" placeholder="Usertype" class="form-control" value="customer">
				<button type="submit" class="search-btn btn--lg">Login</button>
			</form>
			<br><br>
			<h5 class="text-center">Or Login With: </h5>
			<br>
			<div class="card social-block">
				<div class="card-body">
					<a style="font-size: 1.2em;"  href="/auth/google"
						role="button">
						<i class="fab fa-google"></i>
						Login with Google
					</a>
				</div>
			</div>
			<br>
			<div class="card social-block">
				<div class="card-body">
					<a style="font-size: 1.2em;"  href="/auth/facebook"
						role="button">
						<i class="fab fa-facebook"></i>
						Login with Facebook
					</a>
				</div>
			</div>
		</div>
	</div>
</div>
<br><br>
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>