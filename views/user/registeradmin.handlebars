<br><br>
<div class="row">
	<div class="col-md-6 mx-auto">
		
		<br> <br>
		<div class="card card-body">
			<h3 class="text-center">Admin Account Register</h3>
			<br>
		
			<form action="" method="post">
				
				<div class="form-group">
					<label>First Name</label>
					<input type="text" class="form-control" name="firstname" value="{{firstname}}" required>
				</div>
				<div class="form-group">
					<label>Last Name</label>
					<input type="text" class="form-control" name="lastname" value="{{lastname}}" required>
				</div>
				<div class="form-group">
					<label>Username</label>
					<input type="text" name="username" class="form-control" value="{{username}}" required>
				</div>
				<div class="form-group">
                    <label>Password <br>*Password must contain at least eight characters with at least one uppercase letter,
                      one lowercase letter, one number and one special character</label>
                    <input type="password" name="password" placeholder="Password" value="{{password}}" id="password"
                      required>
                    <div><input type="checkbox" onclick="showpassword()">Show Password</div>
                  </div>
				<div class="form-group">
                    <label>Enter password again</label>
                    <input type="password" name="password2" value="{{password2}}" required>
                  </div>
				
				  <label>Gender</label>
				  <div class="search__select select-wrap">
					<select name="gender" class="select--field" id="blah" value="{{gender}}" required>
						<option value="male">Male</option>
						<option value="female">Female</option>
					</select>
					<span class="lnr lnr-chevron-down"></span> 
				</div>
				  <br>
                  <div class="form-group">
                    <label>Email</label>
                    <input type="text" name="email" placeholder="Email" value="{{email}}" required>
                  </div>
                  <div class="form-group">
                    <label>Phone Number</label>
                    <input type="text" name="phoneno" placeholder="Phone Number" value="{{phoneno}}" required>
                  </div>
				{{!-- <div class="form-group">
					<label>Profile Picture</label>
					<input type="file" name="file" class="form-control">
				</div> --}}
				{{!-- <label>Usertype</label>
				  <div class="search__select select-wrap">
					<select name="category" class="select--field" id="blah" value="{{usertype}}" required>
						<option value="customer">Customer</option>
						<option value="counsellor">Counsellor</option>
					</select>
					<span class="lnr lnr-chevron-down"></span> 
				</div> --}}
				<br>
				<button type="submit" class="search-btn btn--lg">Register</button>
			</form>
			<br><br>
			
			{{!-- <h4 class="text-center">Or Register With: </h4> --}}
                {{!-- <div class="card social-block">
                  <div class="card-body">
                    <a style="font-size: 1.2em;" href="/auth/google" role="button">
                      <i class="fab fa-google"></i>
                      Sign Up with Google
                    </a>
                  </div>
                </div>
                <br> --}}
                {{!-- <div class="card social-block">
                  <div class="card-body">
                    <a style="font-size: 1.2em;" href="/auth/facebook" role="button">
                      <i class="fab fa-facebook"></i>
                      Sign Up with Facebook
                    </a>
                  </div>
                </div>
			 --}}
		</div>
		
	</div>
</div>
<br><br>
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
<script>
  function showpassword() {
    var x = document.getElementById("password");
    if (x.type === "password") {
      x.type = "text";
    } else {
      x.type = "password";
    }
  }
</script>