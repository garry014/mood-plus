<script src="https://unpkg.com/@grammarly/editor-sdk?clientId=client_1ihqdkpQn1sy4tKfiw5AQW"></script>
<!-- Socket IO -->
<script src="/socket.io/socket.io.js"></script>
<script>//////////////////////// Socket IO ////////////////////////////////
    var io = io();
</script>
<!-- end of Socket IO -->

<script src="https://developer.emojidata.ai/static/plugin/autocomplete.js"></script>
<script>
    // TODO: to change to actual login user.
    const chat = "{{user.chat}}"
    const username = "{{user.firstname}}" //window.prompt("Enter the username");
    io.emit('new_user', username);

    const messageForm = document.getElementById('message_area');
    const textInput = document.getElementById('message');
    const autocomplete_textbox = document.getElementById('autocomplete-div-0');

    messageForm.addEventListener('submit', function (e) {
        e.preventDefault();
        
        if (autocomplete_textbox.innerText) {
            // Send message TO server
            io.emit('bot_receive_message', autocomplete_textbox.innerText);
            textInput.value = '';
        }
    });

    // Receive message FROM server
    io.on('bot_send_message', (data) => {
        const messageList = document.getElementById('message');

        addNewMessage(data.user, data.message) // addNewMessage(USERNAME, MESSAGE)
        console.log(data)
    });

    function addNewMessage(user, message) {
        var conversation = document.createElement("div");
        conversation.className = "conversation";

        var head = document.createElement("div");
        head.className = "head";

        var chatAvatar = document.createElement("div");
        chatAvatar.className = "chat_avatar";

        var img = document.createElement("img");
        img.src = "images/usr_avatar.png";
        img.alt = "Notification avatar";
        chatAvatar.appendChild(img);

        var nameTime = document.createElement("div");
        nameTime.className = "name_time";

        var nameTimeInner = document.createElement("div");

        var h4 = document.createElement("h4");
        h4.innerHTML = user;
        nameTimeInner.appendChild(h4);

        var p = document.createElement("p");
        p.innerHTML = getDateTimeNow();
        nameTimeInner.appendChild(p);

        nameTime.appendChild(nameTimeInner);

        var span = document.createElement("span");
        span.className = "email";
        nameTime.appendChild(span);

        head.appendChild(chatAvatar);
        head.appendChild(nameTime);

        var body = document.createElement("div");
        body.className = "body";

        var pBody = document.createElement("p");
        body.innerText = message;

        conversation.appendChild(head);
        conversation.appendChild(body);

        var idiv = document.createElement('div'); 
        if(message =="yes" && chat != "Shown"){
            idiv.innerHTML = '<a href="/chat/newchat" class="btn btn--round btn--bordered btn-sm">Seek help from Counsellor</a>';
            counsellor.appendChild(idiv);
        };
        
        chat_area_body = document.getElementById("chat_area--conversation");
        chat_area_body.appendChild(conversation);
    }

    function getDateTimeNow() {
        var today = new Date();
        var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        var date = today.getDate() + " " + months[today.getMonth()] + " " + today.getFullYear();
        var hours = today.getHours();
        var minutes = today.getMinutes();
        var ampm = hours >= 12 ? 'pm' : 'am';
        hours = hours % 12;
        hours = hours ? hours : 12;
        minutes = minutes < 10 ? '0' + minutes : minutes;
        var time = hours + ":" + minutes + " " + ampm;

        return date + " at " + time;
    }

    /////////// Autocomplete.js /////////////////////////

</script>
