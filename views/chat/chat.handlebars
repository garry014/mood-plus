<section class="message_area">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="content_title">
                    <h3>Messages</h3>
                </div>
                <!-- end /.content_title -->
            </div>
            <!-- end /.col-md-12 -->
        </div>
        <!-- end /.row -->

        <div class="row">
            <div class="col-lg-5">
                <div class="cardify messaging_sidebar">
                    <div class="messaging__header">
                        <div class="messaging_menu">
                            <h4>Inbox</h4>

                        </div>
                        <!-- end /.messaging_menu -->


                        <!-- end /.messaging_action -->
                    </div>
                    <!-- end /.messaging__header -->

                    <div class="messaging__contents">

                        <div class="messages">

                            <div class="message active">
                                <div class="message__actions_avatar">

                                    <div class="avatar">
                                        <img src="/images/logo.png" alt="logo image" class="img-fluid">
                                    </div>
                                </div>
                                <!-- end /.actions -->

                                <div class="message_data">
                                    <div class="name_time">
                                        <div class="name">
                                            <p>Mood+ Mental Health Chatbot</p>
                                        </div>

                                        {{!-- <span class="time">Just now</span> --}}
                                        <p>I am Mood+ Chatbot. Feel free to message me!</p>
                                    </div>
                                </div>
                                <!-- end /.message_data -->
                            </div>
                            <!-- end /.message -->


                        </div>
                        <!-- end /.messages -->
                    </div>
                    <!-- end /.messaging__contents -->
                </div>
                <!-- end /.cardify -->
            </div>
            <!-- end /.col-md-5 -->

            <div class="col-lg-7">
                <div class="chat_area cardify">
                    <div class="chat_area--title">
                        <h3>Message with
                            <span class="name">Mood+ Mental Health Chatbot</span>
                        </h3>

                    </div>
                    <!-- end /.chat_area--title -->

                    <div class="chat_area--conversation" id="chat_area--conversation" style="height: 400px; overflow: auto; text-align:justify;">
                        <!-- Chat created using DOM will appear here --->

                    </div>
                    <!-- end /.chat_area--conversation -->

                    {{!-- <div>
                        <input id="mySelect" type="text" name="txt" value="Hello" onchange="myFunction()">
                        <p id="demo"></p>
                    </div> --}}
                    
                    {{!-- <input type="hidden" placeholder="Type a message" style="padding-right: 120px;" required> --}}

                    <div class="message_composer">
                        <form id="message_area" action="">
                            <!--onsubmit="return sendMessage();" class="contact-form-style" -->
                            <p style="font-size: 15px;">Enter TAB key to use autocomplete suggestion</p>
                            <grammarly-editor-plugin config.documentDialect="british"
                                config.suggestionCategories.oxfordComma="on">
                            <div style=" background-color: rgb(195, 195, 195); padding: 10px; border-radius: 3px;"contenteditable="true" class="emojidata-autocomplete" 
                            data-endpoint="/chat/autocomplete" data-depth="3" id="autocomplete-div-0" placeholder="Type a message">Type a message</div>
                             </grammarly-editor-plugin>
                            {{!-- <grammarly-editor-plugin config.documentDialect="british"
                                config.suggestionCategories.oxfordComma="on">
                                <input type="text" autocomplete="on" class="write_msg" id="message" name="message"
                                    placeholder="Type a message" style="padding-right: 120px;">
                            </grammarly-editor-plugin> --}}
                            <div class="btns" style="margin-bottom: 10px" >
                                <button class="btn send btn--sm btn--round" style="display:inline-block">Send</button>
                                <div id="counsellor_btn" style="display:inline-block; float: right;">
                                    {{#ifCond user.chat '==' 'Shown'}}
                                    <a href="/chat/newchat" class="btn btn--round btn--bordered btn-sm">Seek help from Counsellor</a>
                                    {{/ifCond}}
                                </div>
                            </div>
                        </form>
                        <li style="text-align: right;">
                            <a href="/chat/feedback"class="scolor" style="font-weight: bold;">Feedback</a>
                        </li>
                        <div class="attached"></div>


                        <!-- end /.message_composer -->
                    </div>
                    <!-- end /.message_composer -->
                </div>
                <!-- end /.chat_area -->
            </div>
            <!-- end /.col-md-7 -->
        </div>
        <!-- end /.row -->
    </div>
</section>
