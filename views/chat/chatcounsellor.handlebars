<script>//////////////////////// Socket IO ////////////////////////////////
    var io = io();
</script>
<!-- end of Socket IO -->
<!-- grammarly api testing -->
<script src="https://unpkg.com/@grammarly/editor-sdk?clientId=client_1ihqdkpQn1sy4tKfiw5AQW"></script> 

<script>
    function autoScrollDown() {
        $('.chat_area--conversation').scrollTop($('.chat_area--conversation')[0].scrollHeight);
    }
    window.onload = function () {
        autoScrollDown();
    }
    var recipient = "{{recipient}}";
    // TODO: to change to actual login user.
    const username = "{{user.username}}" //window.prompt("Enter the username");

    console.log(recipient)
    io.emit('new_user', username);

    const messageForm = document.getElementById('message_area');
    const textInput = document.getElementById('message');

    messageForm.addEventListener('submit', function(e) {
        e.preventDefault();
        if (textInput.value) {
            // Send message TO server
            sendMessage()
            textInput.value = '';
        }
    });

    function getDateTimeNow(){
        var today = new Date();
        var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        var date = today.getDate() + " " + months[today.getMonth()] + " " + today.getFullYear();
        var hours = today.getHours();
        var minutes = today.getMinutes();
        var ampm = hours >= 12 ? 'pm' : 'am';
        hours = hours % 12;
        hours = hours ? hours : 12;
        minutes = minutes < 10 ? '0' + minutes : minutes;
        var time = hours + ":" + minutes + " " + ampm;

        return date + " at " + time;
    }
    function bumpChat(data){
        console.log(data);
        if(document.body.contains(document.getElementById("chat_"+data.chatid))){
            document.getElementById("chat_"+data.chatid).remove();
        }

        const atag = document.createElement('a');
        atag.id = "chat_" + data.chatid;
        atag.href="/chat/c/inbox/" + data.chatid;
        const div = document.createElement('div');
        div.className = 'messages';
        // data.id for new msg to be change to data.chatid
        if(data.message == undefined){
            data.message = "<i>This chat is currently empty.</i>";
        }

        var tobePrinted = `<div id="chat_people_${data.chatid}" class="message active">
                                <div class="message__actions_avatar">
                                    <div class="avatar">
                                        <img src="/images/usr_avatar.png" alt="logo image" class="img-fluid">
                                    </div>
                                </div>
                                <div class="message_data">
                                        <div class="name_time">
                                            <div class="name">
                                                {{#ifCond ../currentuser "==" recipient}}
                                                ${data.receiver}
                                                {{else}}
                                                    {{#ifCond recipient '==' 'counsellor1'}}
                                                    Counsellor
                                                    {{else}}
                                                    ${data.receiver}
                                                    {{/ifCond}}
                                                {{/ifCond}}
                                            </div>

                                        </div>
                                    </div>
                            
                                </div>
                            </div>`;
        div.innerHTML = tobePrinted;
        atag.appendChild(div);

        if(document.body.contains(document.getElementById("chat_people_"+data.chatid))){
            document.getElementById("chat_people_"+data.chatid).remove();
        }
        
        if(data.chatid == {{id}}){
            // in a current chat
            console.log("current_chat runnning");
            const active_chat = document.getElementById("active_chat");
            active_chat.innerHTML = tobePrinted;
            document.getElementById('inbox_chat').prepend(active_chat); 
        }
        else {
            console.log("alternate path is running");
            document.getElementById('inbox_chat').prepend(atag);
        }
    }

    function sendMessage() {
        var message = document.getElementById("message").value;

        // Send message to server
        io.emit("send_message", {
            sentby: username,
            receiver: recipient,
            message: message,
            {{!-- timestamp: {{timestamp}}, --}}
            chatid: {{id}}
        });

        
        autoScrollDown();
        document.getElementById("message").value = '';
                
        bumpChat({
            sender: sender,
            message: message,
            chatid: {{id}},
            timestamp: getToday()
        });
        return false;
    }

    // listen from server
    io.on("new_message", function (data) {
        console.log("new_message is working");
        const div = document.createElement('div');
        div.className = 'conversation';
        div.innerHTML = `<div class="head">
                            <div class="chat_avatar">
                                <img src="/images/usr_avatar.png" alt="logo image" class="img-fluid">
                            </div>
                            <div class="name_time">
                                <div>
                                    <h4>${data.sentby}</h4>
                                 </div>
                            </div>
                        </div>
                        <div class="body">
                            <p>${data.message}</p>
                        </div>`;

        document.getElementById('chat_area--conversation').appendChild(div); 
        autoScrollDown();
        bumpChat(data);
    });
    
</script>