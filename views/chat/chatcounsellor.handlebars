<!--================================
        START MESSAGE AREA
=================================-->
<section class="message_area">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="content_title">
                    <h3>Messages</h3>
                </div>
                <!-- end /.content_title -->
            </div>
            <!-- end /.col-md-12 -->
        </div>
        <!-- end /.row -->

        <div class="row">
            <div class="col-lg-5">
                <div class="cardify messaging_sidebar">
                    <div class="messaging__header">
                        <div class="messaging_menu">
                            <h4>Inbox</h4>
                        </div>
                        <!-- end /.messaging_menu -->
                        <!-- end /.messaging_action -->
                    </div>
                    <!-- end /.messaging__header -->
                    <div id="inbox_chat" class="messaging__contents">
                    {{#if chats}}
                    {{#each chats}}
                        {{#ifCond id '==' ../id}}
                        <div id="active_chat" class="messages">
                            <div id="chat_people_{{id}}" class="message active">
                                <div class="message__actions_avatar">
                                    <div class="avatar">
                                        <img src="/images/usr_avatar.png" alt="logo image" class="img-fluid">
                                    </div>
                                </div>
                                <!-- end /.actions -->
                                <div class="message_data">
                                    <div class="name_time">
                                        <div class="name">
                                            <p>
                                                {{#ifCond ../currentuser "==" recipient}}
                                                {{sender}} 
                                                {{else}}
                                                    {{#ifCond recipient '==' 'counsellor1'}}
                                                    Counsellor
                                                    {{else}}
                                                    {{recipient}}
                                                    {{/ifCond}}
                                                {{/ifCond}}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- end /.message_data -->
                            </div>
                            <!-- end /.message -->
                        </div>
                        <!-- end /.messages -->
                        {{else}}
                        <a id="chat_{{id}}" href="/chat/c/inbox/{{id}}">
                            <div class="messages">
                                <div id="chat_people_{{id}}" class="message">
                                {{#ifCond ../currentuser "==" recipient}}
                                <div class="message__actions_avatar">
                                    <div class="avatar">
                                        <img src="/images/usr_avatar.png" alt="logo image" class="img-fluid">
                                    </div>
                                </div>
                                {{/ifCond}}
                                <!-- end /.actions -->
                                    <div class="message_data">
                                        <div class="name_time">
                                            <div class="name">
                                                <p>{{#ifCond ../currentuser "==" recipient}}{{sender}}{{else}}{{recipient}}{{/ifCond}}</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                        {{/ifCond}}
                    {{/each}}
                    {{/if}}
                    </div>
                    <!-- end /.messaging__contents -->
                </div>
                <!-- end /.cardify -->
            </div>
            <!-- end /.col-md-5 -->
            {{#ifCond id '!=' 0}}
            <div class="col-lg-7">
                <div class="chat_area cardify">
                    <div class="chat_area--title">
                        <h3>Message with
                            {{#ifCond recipient '==' 'counsellor1'}}
                            Counsellor, Wendy Tan
                            {{else}}
                            {{recipient}}
                            {{/ifCond}}
                            {{!-- <span class="name">{{recipient}}</span> --}}
                        </h3>
                       
                    </div>
                    <!-- end /.chat_area--title -->

                    <div class="chat_area--conversation" id="chat_area--conversation" style="height: 400px; overflow: auto; text-align:justify;">
                        {{#each messages}}
                        {{#if message}}
                        <!-- Chat created using DOM will appear here --->
                        <div class="conversation" >
                            <div class="head">
                                <div class="chat_avatar">
                                    <img src="/images/usr_avatar.png" alt="logo image" class="img-fluid">
                                </div>
                                <div class="name_time">
                                    <div>
                                        {{#ifCond sentby "==" "counsellor1"}}
                                        <h4>Counsellor</h4>
                                        {{else}}
                                        <h4>{{sentby}}</h4>
                                        {{/ifCond}}
                                    </div>
                                </div>
                                <!-- end /.name_time -->
                            </div>
                            <!-- end /.head -->
                            <div class="body">
                                <p>{{message}}</p>
                            </div>
                            <!-- end /.body -->
                        </div>
                        {{/if}}
                        {{/each}}
                    </div>
                    <!-- end /.chat_area--conversation -->
                    <div class="message_composer">
                        {{!-- <form onsubmit="return sendMessage();"> --}}
                        <form id="message_area" action="">
                            <!--onsubmit="return sendMessage();" class="contact-form-style" -->
                            <grammarly-editor-plugin config.documentDialect="british"
                                config.suggestionCategories.oxfordComma="on">
                                <input autocomplete="off" class="write_msg" id="message" name="message" placeholder="Type a message" 
                                type="text" style="padding-right: 120px; background-color: rgb(195, 195, 195);" required>
                            </grammarly-editor-plugin>
                            <div class="btns">
                                <button class="btn send btn--sm btn--round" type="submit" >Send</button>
                            </div>
                        </form>
                        {{!-- <button class="btn send btn--sm btn--round" type="submit" >Send</button> --}}
                        <div class="attached"></div>

                        
                        <!-- end /.message_composer -->
                    </div>
                    <!-- end /.message_composer -->
                </div>
                <!-- end /.chat_area -->
            </div>
             {{/ifCond}}
            <!-- end /.col-md-7 -->
        </div>
        <!-- end /.row -->
    </div>
</section>
<!--================================
        END MESSAGE AREA
=================================-->

<!-- Socket IO -->
